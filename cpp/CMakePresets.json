{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 27, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"PPE_WERROR": "ON"}
    },
    {
      "name": "release-clang",
      "displayName": "Release, clang",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "release-gcc",
      "displayName": "Release, GCC",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer (GCC)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "PPE_SANITIZE": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "clang-tidy (clang, warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "PPE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "release-clang", "configurePreset": "release-clang"},
    {"name": "release-gcc", "configurePreset": "release-gcc"},
    {"name": "asan", "configurePreset": "asan"},
    {"name": "tidy", "configurePreset": "tidy"}
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error"}
    },
    {"name": "release-clang", "inherits": "base", "configurePreset": "release-clang"},
    {"name": "release-gcc", "inherits": "base", "configurePreset": "release-gcc"},
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/sanitizers/lsan.supp:print_suppressions=1"
      }
    }
  ]
}
