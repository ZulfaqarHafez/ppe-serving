<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ppe_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, the sample image replay publisher, a fake NavigateToPose server (stand-in for Nav2), the Gazebo world and the integration tests for ppe_detector and ppe_patrol.</description>
  <maintainer email="noreply@example.com">ppe-ros2 maintainers</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>libopencv-dev</depend>

  <exec_depend>ppe_detector</exec_depend>
  <exec_depend>ppe_patrol</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>vision_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
